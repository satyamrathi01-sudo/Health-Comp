# ---------------------------------------------------------------------
# Supabase — Project Settings → Data API  (and → API Keys for the key)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------
# Google Gemini — free key from https://aistudio.google.com/apikey
# Server-side only. Never prefix this with NEXT_PUBLIC_.
# ---------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-key

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash   # default; falls back automatically if retired
# GEMINI_THINKING_BUDGET=0        # raise if food estimates look sloppy
